PORT=3000
MONGO_URI=mongodb://localhost:27017/bullmq_demo
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Longest wait (ms) between Redis reconnect attempts. The app never stops
# reconnecting, so it recovers by itself after a Redis outage.
REDIS_RETRY_DELAY_MS=2000
# How long (ms) startup waits for Redis before giving up and exiting.
REDIS_STARTUP_TIMEOUT_MS=20000
