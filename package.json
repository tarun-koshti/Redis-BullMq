{
  "name": "bullmq-order-app",
  "version": "1.0.0",
  "private": true,
  "description": "Delayed jobs, retries, cancel and cron (Job Schedulers) with BullMQ, Express and MongoDB",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "example": "tsx",
    "typecheck": "tsc --noEmit && tsc -p example-scripts"
  },
  "dependencies": {
    "bullmq": "^6.3.11",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
